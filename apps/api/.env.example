# Copy to apps/api/.env and fill in. The .env file is git-ignored; never commit real keys.

# Model provider key. Set ONE of these. Without a key the assistant answers from the township
# guide only (no AI model). OpenAI is used if both are set.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Primary and fallback models. Defaults: gpt-4.1-mini / gpt-4o-mini for OpenAI,
# anthropic/claude-haiku-5.5 / google/gemini-3.5-flash-lite for OpenRouter.
# CHAT_MODEL=
# CHAT_FALLBACK_MODEL=

# Longest answer the model may write, in tokens
CHAT_MAX_OUTPUT_TOKENS=600

PORT=8787
HOST=127.0.0.1
APP_URL=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://localhost:4173

# Chat requests per client every 5 minutes
CHAT_RATE_LIMIT=20
# Behind a reverse proxy, take the client IP from X-Forwarded-For (automatic on Vercel)
# TRUST_PROXY=true
CHAT_FIRST_TOKEN_TIMEOUT_MS=15000
LOG_LEVEL=info
